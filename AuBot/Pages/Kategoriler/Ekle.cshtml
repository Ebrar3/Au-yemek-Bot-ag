@page
@model AuBot.Pages.Kategoriler.EkleModel
@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<h1 class="h3 mb-3">Yeni Kategori Ekle</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="YeniKategori.Ad" class="form-label"></label>
                        <input asp-for="YeniKategori.Ad" class="form-control" placeholder="Örn: Çorba, Ana Yemek" />
                        <span asp-validation-for="YeniKategori.Ad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="YeniKategori.Sira" class="form-label"></label>
                        <input asp-for="YeniKategori.Sira" class="form-control" type="number" min="1" max="10" />
                        <div class="form-text">Excel menüsündeki sütun sırası (1: Çorba, 2: Ana Yemek, 3: Yardımcı Yemek, 4: Tatlı/Salata/İçecek).</div>
                        <span asp-validation-for="YeniKategori.Sira" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
