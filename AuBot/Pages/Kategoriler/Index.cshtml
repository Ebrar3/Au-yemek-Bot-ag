@page
@model AuBot.Pages.Kategoriler.IndexModel
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Yemek Kategorileri</h1>
    <a asp-page="Ekle" class="btn btn-primary">+ Yeni Kategori</a>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Menü Sırası</th>
                    <th>Kategori Adı</th>
                    <th>Kayıtlı Yemek Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kategori in Model.Kategoriler)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@kategori.Sira</span></td>
                        <td class="fw-semibold">@kategori.Ad</td>
                        <td>@kategori.Yemekler.Count yemek</td>
                        <td class="text-end">
                            <a asp-page="Detay" asp-route-id="@kategori.Id" class="btn btn-sm btn-outline-info">Detay</a>
                            <a asp-page="Duzenle" asp-route-id="@kategori.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-page="Sil" asp-route-id="@kategori.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
