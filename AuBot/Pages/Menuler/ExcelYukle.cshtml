@page
@using AuBot.Models
@using AuBot.Services
@model AuBot.Pages.Menuler.ExcelYukleModel
@{
    ViewData["Title"] = "Aylık Excel Menü Yükleme";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">📥 Aylık Excel Menü Yükleme</h1>
        <small class="text-muted">Üniversitenin aylık öğle ve akşam Excel (.xlsx) menü dosyalarını yükleyin; yemekler, kaloriler ve tatil günleri otomatik ayrıştırılır.</small>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="/Menuler/Index" class="btn btn-outline-secondary">
            ◀ Menü Yönetimine Dön
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm">
        <div class="fw-bold mb-1">⚠️ Yükleme Sırasında Hata Oluştu:</div>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@if (Model.Sonuc != null)
{
    var s = Model.Sonuc;
    var donemAdi = Model.AyAdiGetir(s.Yil, s.Ay);

    <div class="card border-success shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>✅ Excel Menüsü Başarıyla Aktarıldı:</strong> @s.DosyaAdi
                <span class="badge bg-light text-dark ms-2">@donemAdi – @MenuIslemleri.OgunAdi(s.Ogun)</span>
            </div>
            <a asp-page="/Menuler/Index"
               asp-route-Yil="@s.Yil"
               asp-route-Ay="@s.Ay"
               asp-route-OgunFiltresi="@s.Ogun"
               class="btn btn-sm btn-light fw-semibold">
                📅 @donemAdi Takviminde Görüntüle ▶
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center mb-3">
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="fs-4 fw-bold text-success">@s.EklenenMenuSayisi</div>
                        <div class="small text-muted">Yeni Eklenen Menü</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="fs-4 fw-bold text-primary">@s.GuncellenenMenuSayisi</div>
                        <div class="small text-muted">Güncellenen Menü</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="fs-4 fw-bold text-danger">@s.TatilGunSayisi</div>
                        <div class="small text-muted">Resmi / Yarım Gün Tatil</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="fs-4 fw-bold text-info">@s.YeniYemekSayisi</div>
                        <div class="small text-muted">Yeni Tanımlanan Yemek</div>
                    </div>
                </div>
            </div>

            @if (s.Uyarilar.Any())
            {
                <div class="alert alert-warning mb-0">
                    <div class="fw-bold mb-2">
                        ⚠️ Ayrıştırma Uyarıları ve Otomatik Düzeltmeler (@s.Uyarilar.Count adet):
                    </div>
                    <ul class="mb-0 small">
                        @foreach (var uyari in s.Uyarilar)
                        {
                            <li>@uyari</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0 small">
                    ℹ️ Dosyadaki tüm satırlar herhangi bir tarih veya kalori uyumsuzluğu olmadan aktarıldı.
                </div>
            }
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Excel Dosya Yükleme Formu -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white fw-semibold">
                📤 Yeni Excel Menü Dosyası Yükle
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="ExcelDosyasi" class="form-label fw-semibold">Excel Menü Dosyası (.xlsx)</label>
                        <input asp-for="ExcelDosyasi" type="file" accept=".xlsx" class="form-control" required />
                        <span asp-validation-for="ExcelDosyasi" class="text-danger small"></span>
                        <div class="form-text">
                            Üniversitenin yayınladığı aylık öğle veya akşam yemeği <code>.xlsx</code> dosyasını seçin.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SeciliOgun" class="form-label fw-semibold">Öğün Türü</label>
                        <select asp-for="SeciliOgun" class="form-select">
                            <option value="">🔍 Otomatik Algıla (Excel Başlığından)</option>
                            <option value="@OgunTuru.Ogle">☀️ Öğle Yemeği</option>
                            <option value="@OgunTuru.Aksam">🌙 Akşam Yemeği</option>
                            <option value="@OgunTuru.Vejetaryen">🥗 Vejetaryen Menü</option>
                        </select>
                        <div class="form-text">
                            Boş bırakılırsa dosyanın üst başlığındaki <em>"ÖĞLE"</em> / <em>"AKŞAM"</em> / <em>"VEJETARYEN"</em> ibaresine göre otomatik belirlenir.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        📥 Excel Dosyasını Ayrıştır ve Veritabanına Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Hızlı Örnek Menü Testi ve Format Rehberi -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white fw-semibold">
                🧪 Örnek Menülerle Hızlı Test & Dosya Düzeni
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <p class="small text-muted mb-2">
                        <strong>Beklenen Excel Sütun Yapısı:</strong>
                    </p>
                    <ul class="small mb-3">
                        <li><strong>A Sütunu:</strong> Menü Tarihi (<code>01.10.2026</code>) — <em>farklı ay yazılmış hatalı tarihler otomatik düzeltilip raporlanır.</em></li>
                        <li><strong>B – E Sütunları:</strong> 1: Çorba, 2: Ana Yemek, 3: Yardımcı Yemek, 4: Tatlı/Salata (örn. <code>MAHLUTA ÇORBA (204 kkal)</code>).</li>
                        <li><strong>F Sütunu:</strong> Toplam Kalori (yemek kalorileri toplamıyla uyuşmazsa otomatik düzeltilir).</li>
                        <li><strong>Resmi Tatiller:</strong> B sütununda tatil açıklaması (örn. <code>29 EKİM CUMHURİYET BAYRAMI</code>) yer alır.</li>
                    </ul>
                </div>

                <div class="border-top pt-3">
                    <div class="small fw-semibold mb-2">📂 <code>OrnekMenuler/</code> Klasöründen Tek Tıkla Yükle:</div>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="OrnekYukle">
                            <input type="hidden" name="dosyaAdi" value="Kasim_2026_Ogle_Menusu.xlsx" />
                            <input type="hidden" name="ogun" value="@OgunTuru.Ogle" />
                            <button type="submit" class="btn btn-warning text-dark btn-sm w-100 fw-semibold">
                                ☀️ Kasım 2026 Öğle Menüsünü İçe Aktar
                            </button>
                        </form>
                        <form method="post" asp-page-handler="OrnekYukle">
                            <input type="hidden" name="dosyaAdi" value="Kasim_2026_Aksam_Menusu.xlsx" />
                            <input type="hidden" name="ogun" value="@OgunTuru.Aksam" />
                            <button type="submit" class="btn btn-info text-dark btn-sm w-100 fw-semibold">
                                🌙 Kasım 2026 Akşam Menüsünü İçe Aktar
                            </button>
                        </form>
                        <form method="post" asp-page-handler="OrnekYukle">
                            <input type="hidden" name="dosyaAdi" value="Kasim_2026_Vejetaryen_Menusu.xlsx" />
                            <input type="hidden" name="ogun" value="@OgunTuru.Vejetaryen" />
                            <button type="submit" class="btn btn-success text-white btn-sm w-100 fw-semibold">
                                🥗 Kasım 2026 Vejetaryen Menüsünü İçe Aktar
                            </button>
                        </form>
                        <form method="post" asp-page-handler="OrnekYukle">
                            <input type="hidden" name="dosyaAdi" value="Ekim_2026_Ogle_Menusu.xlsx" />
                            <input type="hidden" name="ogun" value="@OgunTuru.Ogle" />
                            <button type="submit" class="btn btn-outline-warning text-dark btn-sm w-100 fw-semibold">
                                ☀️ Ekim 2026 Öğle Menüsünü Yeniden İçe Aktar
                            </button>
                        </form>
                        <form method="post" asp-page-handler="OrnekYukle">
                            <input type="hidden" name="dosyaAdi" value="Ekim_2026_Aksam_Menusu.xlsx" />
                            <input type="hidden" name="ogun" value="@OgunTuru.Aksam" />
                            <button type="submit" class="btn btn-outline-info text-dark btn-sm w-100 fw-semibold">
                                🌙 Ekim 2026 Akşam Menüsünü Yeniden İçe Aktar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MenuYuklemeleri Kayıt Geçmişi Tablosu -->
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">🗂️ Yükleme Geçmişi (<code>MenuYuklemeleri</code> Kayıtları)</h2>
        <span class="badge bg-secondary">@Model.YuklemeGecmisi.Count kayıt</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.YuklemeGecmisi.Any())
        {
            <div class="p-4 text-center text-muted">
                Henüz yönetici panelinden kaydedilmiş bir Excel menü yüklemesi bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Dosya Adı</th>
                            <th>Dönem</th>
                            <th>Öğün</th>
                            <th>Yükleyen</th>
                            <th>Yükleme Tarihi</th>
                            <th class="text-center">Eklenen / Güncellenen</th>
                            <th class="text-center">Tatil</th>
                            <th>Uyarılar (Hatalı Tarih / Kalori)</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kayit in Model.YuklemeGecmisi)
                        {
                            var uyariSatirlari = string.IsNullOrWhiteSpace(kayit.Uyarilar)
                                ? Array.Empty<string>()
                                : kayit.Uyarilar.Split('\n', StringSplitOptions.RemoveEmptyEntries);

                            <tr>
                                <td class="text-muted small">@kayit.Id</td>
                                <td class="fw-semibold">@kayit.DosyaAdi</td>
                                <td class="text-capitalize">
                                    <a asp-page="/Menuler/Index"
                                       asp-route-Yil="@kayit.Yil"
                                       asp-route-Ay="@kayit.Ay"
                                       asp-route-OgunFiltresi="@kayit.Ogun"
                                       class="text-decoration-none">
                                        @Model.AyAdiGetir(kayit.Yil, kayit.Ay)
                                    </a>
                                </td>
                                <td>
                                    @if (kayit.Ogun == OgunTuru.Ogle)
                                    {
                                        <span class="badge bg-warning text-dark">☀️ Öğle</span>
                                    }
                                    else if (kayit.Ogun == OgunTuru.Aksam)
                                    {
                                        <span class="badge bg-info text-dark">🌙 Akşam</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white">🥗 Vejetaryen</span>
                                    }
                                </td>
                                <td class="small">@(kayit.YukleyenKullaniciId ?? "Sistem")</td>
                                <td class="small text-muted">@kayit.YuklemeTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    <span class="badge bg-success" title="Eklenen Menü">+@kayit.EklenenMenuSayisi</span>
                                    <span class="badge bg-primary" title="Güncellenen Menü">↻@kayit.GuncellenenMenuSayisi</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@kayit.TatilGunSayisi</span>
                                </td>
                                <td style="max-width: 340px;">
                                    @if (uyariSatirlari.Length == 0)
                                    {
                                        <span class="badge bg-success bg-opacity-75">Uyarı Yok</span>
                                    }
                                    else
                                    {
                                        <details>
                                            <summary class="text-warning-emphasis fw-semibold small" style="cursor: pointer;">
                                                ⚠️ @uyariSatirlari.Length uyarı (görmek için tıklayın)
                                            </summary>
                                            <ul class="small text-muted mt-1 mb-0 ps-3">
                                                @foreach (var u in uyariSatirlari)
                                                {
                                                    <li>@u</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Sil" asp-route-id="@kayit.Id" class="d-inline"
                                          onsubmit="return confirm('Bu yükleme geçmişi kaydını silmek istediğinize emin misiniz? (Menüler silinmez)')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Kaydı Sil">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
