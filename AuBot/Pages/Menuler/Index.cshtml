@page
@using AuBot.Models
@model AuBot.Pages.Menuler.IndexModel
@{
    ViewData["Title"] = $"Menü Yönetimi – {Model.AyBasligi}";
    var bugun = DateOnly.FromDateTime(DateTime.Today);
    string[] gunAdlari = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">📋 Menü Yönetimi</h1>
        <small class="text-muted">Menü eklemek için takvimde bir güne tıklayın. Düzenlemek veya silmek için menü kartındaki butonları kullanın.</small>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/Menuler/ExcelYukle" class="btn btn-outline-primary">
            📥 Excel'den Aylık Menü Yükle
        </a>
        <a asp-page="/Menuler/Ekle" class="btn btn-success">
            ➕ Yeni Menü Ekle
        </a>
    </div>
</div>

<!-- Ay Navigasyonu -->
<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <div class="btn-group">
        <a asp-page="/Menuler/Index"
           asp-route-Yil="@Model.OncekiYil"
           asp-route-Ay="@Model.OncekiAy"
           asp-route-OgunFiltresi="@Model.OgunFiltresi"
           class="btn btn-outline-primary">◀ Önceki Ay</a>
        <a asp-page="/Menuler/Index"
           asp-route-Yil="@bugun.Year"
           asp-route-Ay="@bugun.Month"
           class="btn btn-outline-secondary">Bu Ay</a>
        <a asp-page="/Menuler/Index"
           asp-route-Yil="@Model.SonrakiYil"
           asp-route-Ay="@Model.SonrakiAy"
           asp-route-OgunFiltresi="@Model.OgunFiltresi"
           class="btn btn-outline-primary">Sonraki Ay ▶</a>
    </div>

    <h2 class="h4 mb-0 text-capitalize">📅 @Model.AyBasligi</h2>

    <div class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0 small text-muted">Öğün:</label>
        <div class="btn-group btn-group-sm">
            <a asp-page="/Menuler/Index"
               asp-route-Yil="@Model.SeciliYil"
               asp-route-Ay="@Model.SeciliAy"
               class="btn @(Model.OgunFiltresi == null ? "btn-primary" : "btn-outline-primary")">Tümü</a>
            <a asp-page="/Menuler/Index"
               asp-route-Yil="@Model.SeciliYil"
               asp-route-Ay="@Model.SeciliAy"
               asp-route-OgunFiltresi="@OgunTuru.Ogle"
               class="btn @(Model.OgunFiltresi == OgunTuru.Ogle ? "btn-warning" : "btn-outline-warning")">☀️ Öğle</a>
            <a asp-page="/Menuler/Index"
               asp-route-Yil="@Model.SeciliYil"
               asp-route-Ay="@Model.SeciliAy"
               asp-route-OgunFiltresi="@OgunTuru.Aksam"
               class="btn @(Model.OgunFiltresi == OgunTuru.Aksam ? "btn-info" : "btn-outline-info")">🌙 Akşam</a>
            <a asp-page="/Menuler/Index"
               asp-route-Yil="@Model.SeciliYil"
               asp-route-Ay="@Model.SeciliAy"
               asp-route-OgunFiltresi="@OgunTuru.Vejetaryen"
               class="btn @(Model.OgunFiltresi == OgunTuru.Vejetaryen ? "btn-success" : "btn-outline-success")">🥗 Vejetaryen</a>
        </div>
    </div>
</div>

<!-- Takvim Tablosu -->
<div class="table-responsive shadow-sm rounded border bg-white mb-4">
    <table class="table table-bordered align-top mb-0" style="table-layout: fixed; min-width: 900px;">
        <thead class="table-dark text-center">
            <tr>
                @foreach (var gunAdi in gunAdlari)
                {
                    <th class="py-2">@gunAdi</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                int hucreSayaci = 0;
                int toplamHucre = Model.BaslangicBosGunSayisi + Model.AyinGunSayisi;
                int satirSayisi = (int)Math.Ceiling(toplamHucre / 7.0);
            }

            @for (int satir = 0; satir < satirSayisi; satir++)
            {
                <tr>
                    @for (int sutun = 0; sutun < 7; sutun++)
                    {
                        int gunNo = hucreSayaci - Model.BaslangicBosGunSayisi + 1;
                        hucreSayaci++;

                        if (gunNo < 1 || gunNo > Model.AyinGunSayisi)
                        {
                            <td class="bg-light" style="height: 150px;"></td>
                        }
                        else
                        {
                            var tarih = new DateOnly(Model.SeciliYil, Model.SeciliAy, gunNo);
                            var bugunMu = tarih == bugun;
                            Model.GunlukMenuler.TryGetValue(tarih, out var gunMenuleri);
                            var tarihStr = tarih.ToString("yyyy-MM-dd");

                            <td class="@(bugunMu ? "border-primary border-2 bg-primary bg-opacity-10" : "")" style="height: 150px; padding: 6px;">
                                <!-- Gün Başlığı -->
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold @(bugunMu ? "text-primary" : "text-dark")">
                                        @gunNo
                                        @if (bugunMu)
                                        {
                                            <span class="badge bg-primary ms-1" style="font-size: 0.6rem;">Bugün</span>
                                        }
                                    </span>
                                    <!-- Ekle Butonu -->
                                    <a asp-page="/Menuler/Ekle"
                                       asp-route-tarih="@tarihStr"
                                       class="btn btn-success btn-sm py-0 px-1"
                                       style="font-size: 0.75rem;"
                                       title="Bu tarihe menü ekle">+</a>
                                </div>

                                <!-- Mevcut Menüler -->
                                @if (gunMenuleri == null || !gunMenuleri.Any())
                                {
                                    <div class="text-muted small fst-italic" style="font-size: 0.72rem;">Menü yok</div>
                                }
                                else
                                {
                                    @foreach (var menu in gunMenuleri)
                                    {
                                        <div class="mb-1 p-1 rounded small @(menu.Ogun == OgunTuru.Ogle ? "border border-warning bg-warning bg-opacity-10" : menu.Ogun == OgunTuru.Aksam ? "border border-info bg-info bg-opacity-10" : "border border-success bg-success bg-opacity-10")" style="font-size: 0.72rem;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fw-semibold">@(menu.Ogun == OgunTuru.Ogle ? "☀️ Öğle" : menu.Ogun == OgunTuru.Aksam ? "🌙 Akşam" : "🥗 Vejetaryen")</span>
                                                <div class="d-flex gap-1">
                                                    <a asp-page="/Menuler/Duzenle"
                                                       asp-route-id="@menu.Id"
                                                       class="btn btn-outline-primary py-0 px-1"
                                                       style="font-size: 0.65rem;"
                                                       title="Düzenle">✏️</a>
                                                    <form method="post" asp-page-handler="Sil" style="display:inline;"
                                                          onsubmit="return confirm('@menu.Ogun == OgunTuru.Ogle ? \"Öğle\" : \"Akşam\" menüsünü silmek istediğinizden emin misiniz?')">
                                                        <input type="hidden" name="id" value="@menu.Id" />
                                                        <input type="hidden" name="SeciliYil" value="@Model.SeciliYil" />
                                                        <input type="hidden" name="SeciliAy" value="@Model.SeciliAy" />
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger py-0 px-1"
                                                                style="font-size: 0.65rem;" title="Sil">🗑️</button>
                                                    </form>
                                                </div>
                                            </div>
                                            @if (menu.TatilMi)
                                            {
                                                <div class="text-danger mt-1">Tatil</div>
                                            }
                                            else
                                            {
                                                @if (menu.ToplamKalori != null)
                                                {
                                                    <span class="badge bg-secondary" style="font-size: 0.6rem;">@menu.ToplamKalori kkal</span>
                                                }
                                                <ul class="list-unstyled mb-0 mt-1">
                                                    @foreach (var my in menu.MenuYemekleri.OrderBy(x => x.Sira))
                                                    {
                                                        <li class="text-truncate" title="@my.Yemek?.Ad">• @my.Yemek?.Ad</li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                }
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- İstatistik Özeti -->
@{
    var toplamMenu = Model.GunlukMenuler.Values.Sum(l => l.Count);
    var ogleCount = Model.GunlukMenuler.Values.SelectMany(l => l).Count(m => m.Ogun == OgunTuru.Ogle);
    var aksamCount = Model.GunlukMenuler.Values.SelectMany(l => l).Count(m => m.Ogun == OgunTuru.Aksam);
    var vejCount = Model.GunlukMenuler.Values.SelectMany(l => l).Count(m => m.Ogun == OgunTuru.Vejetaryen);
}
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center border-primary">
            <div class="card-body py-2">
                <div class="fs-4 fw-bold text-primary">@toplamMenu</div>
                <div class="small text-muted">Toplam Menü</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body py-2">
                <div class="fs-4 fw-bold text-warning">@ogleCount</div>
                <div class="small text-muted">☀️ Öğle Menüsü</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-info">
            <div class="card-body py-2">
                <div class="fs-4 fw-bold text-info">@aksamCount</div>
                <div class="small text-muted">🌙 Akşam Menüsü</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <div class="fs-4 fw-bold text-success">@vejCount</div>
                <div class="small text-muted">🥗 Vejetaryen Menü</div>
            </div>
        </div>
    </div>
</div>
