@page "{id:int}"
@model AuBot.Pages.Yemekler.DuzenleModel
@{
    ViewData["Title"] = "Yemek Düzenle";
}

<h1 class="h3 mb-3">Yemek Düzenle</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="DuzenlenenYemek.Ad" class="form-label"></label>
                        <input asp-for="DuzenlenenYemek.Ad" class="form-control" />
                        <span asp-validation-for="DuzenlenenYemek.Ad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DuzenlenenYemek.KategoriId" class="form-label"></label>
                        <select asp-for="DuzenlenenYemek.KategoriId" asp-items="Model.Kategoriler" class="form-select">
                            <option value="">-- Kategori seçiniz --</option>
                        </select>
                        <span asp-validation-for="DuzenlenenYemek.KategoriId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DuzenlenenYemek.Kalori" class="form-label"></label>
                        <input asp-for="DuzenlenenYemek.Kalori" class="form-control" type="number" min="0" max="3000" />
                        <span asp-validation-for="DuzenlenenYemek.Kalori" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
