@page
@model AuBot.Pages.Yemekler.IndexModel
@{
    ViewData["Title"] = "Yemekler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Yemek Listesi</h1>
    <a asp-page="Ekle" class="btn btn-primary">+ Yeni Yemek Ekle</a>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input asp-for="Arama" class="form-control" placeholder="Yemek adına göre ara..." />
    </div>
    <div class="col-md-3">
        <select asp-for="KategoriId" asp-items="Model.Kategoriler" class="form-select">
            <option value="">Tüm Kategoriler</option>
        </select>
    </div>
    <div class="col-md-3">
        <select asp-for="Siralama" class="form-select">
            <option value="ad">Ada göre (A–Z)</option>
            <option value="kalori_artan">Kaloriye göre (Artan)</option>
            <option value="kalori_azalan">Kaloriye göre (Azalan)</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Yemek Adı</th>
                    <th>Kategori</th>
                    <th>Kalori</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Yemekler.Any())
                {
                    @foreach (var yemek in Model.Yemekler)
                    {
                        <tr>
                            <td class="fw-semibold">@yemek.Ad</td>
                            <td><span class="badge bg-info text-dark">@yemek.Kategori?.Ad</span></td>
                            <td>@(yemek.Kalori.HasValue ? $"{yemek.Kalori} kkal" : "-")</td>
                            <td class="text-end">
                                <a asp-page="Detay" asp-route-id="@yemek.Id" class="btn btn-sm btn-outline-info">Detay</a>
                                <a asp-page="Duzenle" asp-route-id="@yemek.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-page="Sil" asp-route-id="@yemek.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Arama kriterlerine uygun yemek bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
